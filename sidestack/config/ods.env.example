# SideStack Voice Studio: ODS profile (template, no secrets).
#
# The launcher (VS-07) reads this file, then copies secrets from Windows USER env vars into the
# backend process only. Never put a key in this file. Copies named *.env are gitignored.
# Format: KEY=VALUE per line, comments on their own lines only (no inline comments).
# Lines after a "VERIFY [lane]" comment are confirmed by that lane before being relied on.

# ── LLM: ODS local model relay (OpenAI-compatible, loopback) ─────────────────────────────
# Phase 2 starts with the built-in "custom" provider. VS-04 adds a first-class "ods" provider.
# TRANSLATE_API_KEY is set by the launcher from user env ODS_LOCAL_MODEL_RELAY_KEY.
LLM_DEFAULT_PROVIDER=custom
TRANSLATE_BASE_URL=http://127.0.0.1:4007/v1
# VERIFY [VS-03]: id listed by the relay's /v1/models
TRANSLATE_MODEL=ods/current

# ── ASR: ODS Whisper (OpenAI-compatible, loopback, no key) ──────────────────────────────
OMNIVOICE_ASR_BACKEND=openai-compat-asr
ASR_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:9000/v1
# VERIFY [VS-05]: id listed by ODS Whisper's /v1/models (SideStack Meetings uses this one)
ASR_OPENAI_COMPAT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2

# ── Server (headless web UI + /v1 speech API) ───────────────────────────────────────────
# OMNIVOICE_API_KEY is set by the launcher from user env SIDESTACK_VOICESTUDIO_API_KEY.
OMNIVOICE_BIND_HOST=127.0.0.1
# backend/main.py reads OMNIVOICE_PORT and OMNIVOICE_BIND_HOST (default 127.0.0.1).
# VERIFY [VS-02]: it also serves frontend/dist when run natively on Windows.
OMNIVOICE_PORT=3900
OMNIVOICE_SERVER_MODE=1

# ── Data (outside the repo) ─────────────────────────────────────────────────────────────
OMNIVOICE_DATA_DIR=E:\SideStackAI\data\voice-studio
HF_HOME=E:\SideStackAI\data\voice-studio\huggingface

# ── Local-first: models download only on an explicit user action; tests run offline ─────
PYTHONUNBUFFERED=1
