# SideStack Voice Studio: ODS profile (template, no secrets).
#
# The launcher (VS-07) reads this file, then copies secrets from Windows USER env vars into the
# backend process only. Never put a key in this file. Copies named *.env are gitignored.
# Format: KEY=VALUE per line, comments on their own lines only (no inline comments).
# Lines after a "VERIFY [lane]" comment are confirmed by that lane before being relied on.

# ── LLM: ODS local model relay (OpenAI-compatible, loopback) ─────────────────────────────
# VS-07: the first-class "ods" provider (VS-04) reads user env ODS_LOCAL_MODEL_RELAY_KEY itself;
# nothing copies the key. TRANSLATE_* below stay as the legacy fallback.
LLM_DEFAULT_PROVIDER=ods
# Dub translation uses the LLM engine through the active provider (ODS), never an online service.
TRANSLATE_PROVIDER=openai
TRANSLATE_BASE_URL=http://127.0.0.1:4007/v1
# Verified 2026-11-06 (VS-03): relay /v1/models lists ods/current and default (ctx 131072);
# the custom provider resolves with no configuration error and one chat returned "OK" in 4.3 s.
TRANSLATE_MODEL=ods/current

# ── ASR: ODS Whisper (OpenAI-compatible, loopback, no key) ──────────────────────────────
OMNIVOICE_ASR_BACKEND=openai-compat-asr
ASR_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:9000/v1
# Verified 2026-11-06 (VS-05): listed by ODS Whisper's /v1/models; one synthetic clip transcribed
# keyless through Voice Studio's openai-compat-asr backend, all words correct (SideStack Meetings uses this one).
ASR_OPENAI_COMPAT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# VS-14: dictation (mic button, live partials, /capture/transcribe) uses the same ODS Whisper.
SIDESTACK_DICTATION_ODS=1
# VS-30: a cold ODS Whisper reloads its model in about 103 s (VS-29), past upstream's 120 s
# per-chunk dub transcription limit. 300 s matches OMNIVOICE_ASR_TRANSCRIBE_TIMEOUT_S.
OMNIVOICE_TRANSCRIBE_CHUNK_TIMEOUT_S=300

# ── Server (headless web UI + /v1 speech API) ───────────────────────────────────────────
# OMNIVOICE_SERVER_MODE stays unset: it is for Docker and turns off the loopback admin gate.
OMNIVOICE_BIND_HOST=127.0.0.1
# backend/main.py reads OMNIVOICE_PORT and OMNIVOICE_BIND_HOST (default 127.0.0.1).
# Verified 2026-11-05 (VS-02): it also serves frontend/dist when run natively on Windows.
OMNIVOICE_PORT=3900

# ── GPU admission (VS-06): refuse TTS loads that would not fit beside ODS ─────────────────
SIDESTACK_VRAM_ADMISSION=1
SIDESTACK_VRAM_MARGIN_GB=1.0
# VS-18: refuse models whose licence is not commercial (for example OmniVoice), even if
# accepted. Start the launcher with -AllowNonCommercial for private work only.
SIDESTACK_COMMERCIAL_ONLY=1
# VS-19: the TTS engine used until one is picked in Settings. VoxCPM2 has a commercial
# licence and does cloning and voice design. Unlike OMNIVOICE_TTS_BACKEND it does not pin.
SIDESTACK_DEFAULT_TTS_BACKEND=voxcpm2

# ── Data (outside the repo) ─────────────────────────────────────────────────────────────
OMNIVOICE_DATA_DIR=E:\SideStackAI\data\voice-studio
HF_HOME=E:\SideStackAI\data\voice-studio\huggingface
OMNIVOICE_ENV_FILE=E:\SideStackAI\data\voice-studio\omnivoice-user.env

# ── Python environment (outside any harness workspace; see harness/README.md) ───────────
UV_PROJECT_ENVIRONMENT=E:\SideStackAI\data\voice-studio\venvs\voicestudio-001

# ── Local-first: models download only on an explicit user action; tests run offline ─────
PYTHONUNBUFFERED=1
